# MediKiosk / MediCase AI Backend - environment variables
# Copy this to .env and fill in values. Never commit .env.

# Server
PORT=4000
APP_ENV=development

# Cross-origin allowed for the frontend (use * for dev, restrict in prod)
CORS_ORIGIN=*

# Session expiry in minutes; completed/expired sessions are auto-purged after this
SESSION_EXPIRY_MINUTES=60

# --- Persistence ---
# Directory (relative to backend cwd) where the JSON database file is stored.
# Data survives server restarts.
DATA_DIR=data

# --- Doctor authentication ---
# A doctor logs in to reach the dashboard. Credentials below are the seeded
# default - override both in production. JWT_SECRET MUST be a strong secret.
DOCTOR_USERNAME=admin
DOCTOR_PASSWORD=doctor123
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# --- LLM / AI API (optional) ---
# When set, the interview engine and summary generation use a real LLM
# (OpenAI/Groq-compatible). When blank, a rule-based engine is used.
LLM_API_KEY=
# LLM_MODEL=llama-3.1-8b-instant

# --- OCR API (optional) ---
# When the key + endpoint are both set, document OCR uses a real
# Document-Intelligence-compatible endpoint. Otherwise OCR is simulated.
OCR_API_KEY=
OCR_ENDPOINT=

# --- ABDM/FHIR integration (leave blank to use MockFHIRService in dev) ---
FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
